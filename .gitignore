# ==============================================================================
# Git Ignore Configuration
# ==============================================================================

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# Environment & Secrets (Never commit credentials)
.env
.env.local
.env.*.local
*.pem
*.key
*.cert
*.crt
*.pfx
*.secret

# IDE & Editor Directories
.idea/
.vscode/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~

# Agent & Local IDE Cache
.agents/
.gemini/
AGENTS.md
GEMINI.md

# Dependency Directories
node_modules/
jspm_packages/
web_modules/

# Python Virtual Environments & Bytecode
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
ENV/
.pytest_cache/
*.egg-info/

# Build & Distribution Artifacts
dist/
build/
out/
.next/
.nuxt/
.cache/
*.tsbuildinfo

# Logs & Temporary Files
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
tmp/
temp/
